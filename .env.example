# Copy this file to .env and fill in the values. Never commit .env.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# True only on your own computer. Must be False on a live server.
DJANGO_DEBUG=True

# Comma-separated domain names this site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started)
PAGESPEED_API_KEY=
