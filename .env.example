# Copy this file to .env and fill in the values. Never commit .env.
# Every variable is explained in docs/06-configuration.md

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# True only on your own computer. Always False on a live server.
DJANGO_DEBUG=True

# Comma-separated domain names this site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. With Docker running (docker compose up postgres redis):
DATABASE_URL=postgres://bizzcheckup:bizzcheckup@localhost:5432/bizzcheckup
# Quick try-out without Docker:
# DATABASE_URL=sqlite:///db.sqlite3

# How check-ups run: "immediate" (default, no Redis needed) or "celery" (separate worker).
CHECKUP_RUNNER=immediate

# Redis: only needed with CHECKUP_RUNNER=celery.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Google PageSpeed Insights API key. Leave empty to skip performance checks.
# Get one: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# --- Abuse protection (defaults shown) ---
# CHECKUP_RATE_LIMIT_PER_HOUR=5
# CHECKUP_QUEUE_CAP=20
# CHECKUP_REUSE_HOURS=24
# Secret salt for hashing visitor IPs (defaults to DJANGO_SECRET_KEY).
# IP_HASH_SALT=
# Only behind a reverse proxy that sets X-Forwarded-For:
# TRUST_X_FORWARDED_FOR=False

# Cloudflare Turnstile (optional). Both keys on = the widget appears on the form.
# https://developers.cloudflare.com/turnstile/get-started/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
